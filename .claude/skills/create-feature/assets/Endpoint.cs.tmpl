using InvoiceBuilder.Api.Shared.Infrastructure.Validation;
using InvoiceBuilder.Application.Features.{{Feature}};
using InvoiceBuilder.Application.Features.{{Feature}}.Models.{{Op}};
using MediatR;
using Microsoft.AspNetCore.Mvc;

namespace InvoiceBuilder.Api.Features.{{Feature}}.{{Entity}}{{Op}};

public static class {{Op}}{{Entity}}Endpoint
{
	public static void Map{{Op}}{{Entity}}Endpoint(this IEndpointRouteBuilder app)
	{
		app.MapPost("/", async (
			[FromBody] {{Op}}{{Entity}}Dto dto,
			[FromServices] IMediator mediator) =>
		{
			var result = await mediator.Send(new {{Op}}{{Entity}}Command(dto));
			if (result.IsFailure)
			{
				return Results.BadRequest(result.Error);
			}

			var idN = result.Value!.Id.ToString("N");
			var location = $"/api/{{RouteSegment}}/{idN}";

			var response = new {{Op}}{{Entity}}ResponseDto(
				Id: idN,
				Location: location,
				CreatedAt: result.Value.CreatedAt);

			return Results.Created(location, response);
		})
		.AddEndpointFilter<ValidationFilter<{{Op}}{{Entity}}Dto>>()
		.WithName("{{Op}}{{Entity}}")
		.WithSummary("TODO: one-line summary.")
		.WithDescription("TODO: what this endpoint does.")
		.Produces<{{Op}}{{Entity}}ResponseDto>(StatusCodes.Status201Created)
		.Produces<ValidationProblemDetails>(StatusCodes.Status400BadRequest)
		.ProducesProblem(StatusCodes.Status500InternalServerError);
	}
}
