@page "/invoices"
@rendermode InteractiveServer

@using System.Net
@using InvoiceBuilder.Application.Features.Invoices.Models.Get
@using InvoiceBuilder.Application.Shared.Responses.Invoices
@using InvoiceBuilder.Web.Services
@using MudBlazor
@using Refit

@inject IInvoicesApiClient InvoicesApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Invoices</PageTitle>

<MudContainer>
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">
            Invoices
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/invoices/new">
            New Invoice
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_error
        </MudAlert>
    }

    <MudTable T="InvoiceListItem"
              Items="_invoices"
              Hover="true"
              Striped="true"
              Dense="true"
              Loading="_loading">
        <HeaderContent>
            <MudTh>Invoice #</MudTh>
            <MudTh>Invoice Date</MudTh>
            <MudTh>Due Date</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Invoice #">@context.InvoiceNumber</MudTd>
            <MudTd DataLabel="Invoice Date">@context.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Due Date">@context.DueDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Total" Style="text-align:right">@context.TotalAmount.ToString("N2")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Disabled="_loading"
                               aria-label="View invoice"
                               OnClick="() => ViewInvoice(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               Disabled="_loading"
                               aria-label="Delete invoice"
                               OnClick="() => DeleteInvoice(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @if (!_loading)
            {
                <MudText>No invoices found.</MudText>
            }
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-4">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ChevronLeft"
                   Disabled="_loading || !_hasPreviousPage"
                   OnClick="LoadPreviousPage">
            Previous
        </MudButton>
        <MudText Typo="Typo.body2">Page @(_pageNumber)</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ChevronRight"
                   Disabled="_loading || !_hasNextPage"
                   OnClick="LoadNextPage">
            Next
        </MudButton>
    </MudStack>

</MudContainer>

@code {

    private const int PageSize = 5;

    private readonly List<InvoiceListItem> _invoices = new();
    private Guid? _nextCursor;
    private Guid? _previousCursor;
    private bool _hasNextPage;
    private bool _hasPreviousPage;
    private int _pageNumber = 1;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
        => await LoadInvoices();

    private Task LoadNextPage()
        => LoadInvoices(_nextCursor, isNextPage: true, _pageNumber + 1);

    private Task LoadPreviousPage()
        => LoadInvoices(_previousCursor, isNextPage: false, _pageNumber - 1);

    private async Task LoadInvoices(Guid? cursor = null, bool? isNextPage = null, int pageNumber = 1)
    {
        try
        {
            _loading = true;
            _error = null;

            var request = new GetInvoicesDto(
                Cursor: cursor,
                IsNextPage: isNextPage,
                PageSize: PageSize);

            var result = await InvoicesApiClient.GetInvoicesAsync(request);

            _invoices.Clear();
            _invoices.AddRange(result.Items);
            _nextCursor = result.NextCursor;
            _previousCursor = result.PreviousCursor;
            _hasNextPage = result.NextCursor.HasValue;
            _hasPreviousPage = result.PreviousCursor.HasValue;
            _pageNumber = pageNumber;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load invoices: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ViewInvoice(InvoiceListItem item)
        => NavigationManager.NavigateTo($"/invoices/{item.Id}");

    private async Task DeleteInvoice(InvoiceListItem item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete invoice",
            $"Delete invoice \"{item.InvoiceNumber}\"? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (!confirmed.GetValueOrDefault())
        {
            return;
        }

        try
        {
            await InvoicesApiClient.DeleteInvoiceAsync(item.Id);
            _invoices.RemoveAll(i => i.Id == item.Id);
            Snackbar.Add("Invoice deleted", Severity.Success);
            StateHasChanged();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            Snackbar.Add("Invoice was already deleted.", Severity.Warning);
            _invoices.RemoveAll(i => i.Id == item.Id);
            StateHasChanged();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Delete failed ({(int)ex.StatusCode} {ex.ReasonPhrase})", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

}
