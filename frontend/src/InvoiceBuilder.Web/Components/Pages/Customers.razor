@page "/customers"
@rendermode InteractiveServer

@using InvoiceBuilder.Application.Features.Customers.Models.Get
@using InvoiceBuilder.Application.Shared.Responses.Customers
@using InvoiceBuilder.Web.Services
@using MudBlazor

@inject ICustomersApiClient CustomersApiClient

<PageTitle>Customers</PageTitle>

<MudContainer>
    <MudText Typo="Typo.h4" class="mb-4">
        Customer Management
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_error
        </MudAlert>
    }

    <MudTable T="CustomerListItem"
              Items="_customers"
              Hover="true"
              Striped="true"
              Dense="true"
              Loading="_loading">
        <HeaderContent>
            <MudTh>Company</MudTh>
            <MudTh>Customer Name</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Company">@context.CompanyName</MudTd>
            <MudTd DataLabel="Customer Name">@context.CustomerName</MudTd>
            <MudTd DataLabel="Email">@context.CustomerEmail</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @if (!_loading)
            {
                <MudText>No customers found.</MudText>
            }
        </NoRecordsContent>
    </MudTable>

    @if (_hasMorePages)
    {
        <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Disabled="_loading"
                       OnClick="() => LoadCustomers(true)">
                Load More
            </MudButton>
        </MudStack>
    }

</MudContainer>

@code {

    private const int PageSize = 5;

    private readonly List<CustomerListItem> _customers = new();
    private Guid? _nextCursor;
    private bool _hasMorePages = true;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
        => await LoadCustomers();

    private async Task LoadCustomers(bool append = false)
    {
        try
        {
            _loading = true;
            _error = null;

            var request = new GetCustomersDto(
                Cursor: append ? _nextCursor : null,
                IsNextPage: append ? true : null,
                PageSize: PageSize);

            var result = await CustomersApiClient.GetCustomersAsync(request);

            if (!append)
                _customers.Clear();

            _customers.AddRange(result.Items);
            _nextCursor = result.NextCursor;
            _hasMorePages = _nextCursor.HasValue;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load customers: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

}
