@page "/invoices/new"
@rendermode InteractiveServer

@using System.Net
@using System.Text.Json
@using InvoiceBuilder.Application.Features.Customers.Models.Get
@using InvoiceBuilder.Application.Features.Invoices.Models.Create
@using InvoiceBuilder.Application.Features.Senders.Models.Get
@using InvoiceBuilder.Application.Shared.Responses.Customers
@using InvoiceBuilder.Application.Shared.Responses.Senders
@using InvoiceBuilder.Web.Services
@using MudBlazor
@using Refit

@inject IInvoicesApiClient InvoicesApiClient
@inject ICustomersApiClient CustomersApiClient
@inject ISendersApiClient SendersApiClient
@inject ISnackbar Snackbar

<PageTitle>New Invoice</PageTitle>

<MudContainer>
    <MudText Typo="Typo.h4" Class="mb-4">New Invoice</MudText>

    @if (_loadingLookups)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudForm @ref="_form" Model="_model" @key="_formVersion">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.InvoiceNumber"
                                  Label="Invoice Number"
                                  Required="true"
                                  RequiredError="Invoice number is required"
                                  Variant="Variant.Outlined"
                                  Error="_serverErrors.ContainsKey(nameof(_model.InvoiceNumber))"
                                  ErrorText="@_serverErrors.GetValueOrDefault(nameof(_model.InvoiceNumber))" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.InvoiceDate"
                                   Label="Invoice Date"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.DueDate"
                                   Label="Due Date"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_model.CustomerId" Label="Customer" Required="true" Variant="Variant.Outlined">
                        @foreach (var customer in _customers)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)customer.Id)">@customer.CompanyName (@customer.CustomerName)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_model.SenderId" Label="Sender" Required="true" Variant="Variant.Outlined">
                        @foreach (var sender in _senders)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)sender.Id)">@sender.SenderCompanyName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Currency"
                                  Label="Currency"
                                  Required="true"
                                  RequiredError="Currency is required"
                                  Variant="Variant.Outlined"
                                  Error="_serverErrors.ContainsKey(nameof(_model.Currency))"
                                  ErrorText="@_serverErrors.GetValueOrDefault(nameof(_model.Currency))" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="_taxRatePercent"
                                      Label="Tax Rate (%)"
                                      Min="0"
                                      Immediate="true"
                                      Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="Notes"
                                  Lines="2"
                                  Required="true"
                                  RequiredError="Notes are required"
                                  Variant="Variant.Outlined"
                                  Error="_serverErrors.ContainsKey(nameof(_model.Notes))"
                                  ErrorText="@_serverErrors.GetValueOrDefault(nameof(_model.Notes))" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6" Class="mb-2">Line Items</MudText>
                </MudItem>

                @foreach (var (item, index) in _lineItems.Select((li, i) => (li, i)))
                {
                    <MudItem xs="12">
                        <MudPaper Class="d-flex align-center ga-2 pa-2 mb-2" Outlined="true">
                            <MudTextField T="string" @bind-Value="item.ItemName" Label="Item" Immediate="true" Class="flex-grow-1" />
                            <MudNumericField T="decimal" @bind-Value="item.Quantity" Label="Qty" Min="0" Immediate="true" Style="width:100px" />
                            <MudNumericField T="decimal" @bind-Value="item.UnitPrice" Label="Unit Price" Min="0" Immediate="true" Style="width:140px" />
                            <MudText Style="width:140px; text-align:right">@item.Total.ToString("C")</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           aria-label="Remove line item"
                                           OnClick="() => RemoveLineItem(index)" />
                        </MudPaper>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineItem">Add line item</MudButton>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudStack Class="ml-auto" Style="max-width:320px">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText>Subtotal</MudText>
                            <MudText>@Subtotal.ToString("C")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText>Tax (@_taxRatePercent%)</MudText>
                            <MudText>@TaxAmount.ToString("C")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">Total</MudText>
                            <MudText Typo="Typo.h6">@TotalAmount.ToString("C")</MudText>
                        </MudStack>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudForm>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="_saving"
                       OnClick="Submit">
                @if (_saving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Saving</MudText>
                }
                else
                {
                    <MudText>Create Invoice</MudText>
                }
            </MudButton>
        </MudStack>
    }
</MudContainer>

@code {

    private readonly InvoiceFormModel _model = new();
    private readonly List<LineItemModel> _lineItems = new() { new LineItemModel() };
    private readonly Dictionary<string, string> _serverErrors = new();
    private readonly List<CustomerListItem> _customers = new();
    private readonly List<SenderListItem> _senders = new();

    private MudForm _form = default!;
    private int _formVersion;
    private decimal _taxRatePercent;
    private bool _loadingLookups = true;
    private bool _saving;
    private string? _errorMessage;

    private decimal Subtotal => _lineItems.Sum(li => li.Total);
    private decimal TaxAmount => Math.Round(Subtotal * (_taxRatePercent / 100m), 2);
    private decimal TotalAmount => Subtotal + TaxAmount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loadingLookups = true;
            _customers.AddRange(await LoadAllCustomersAsync());
            _senders.AddRange(await LoadAllSendersAsync());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customers/senders: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingLookups = false;
        }
    }

    private async Task<List<CustomerListItem>> LoadAllCustomersAsync()
    {
        var all = new List<CustomerListItem>();
        Guid? cursor = null;
        while (true)
        {
            var page = await CustomersApiClient.GetCustomersAsync(new GetCustomersDto(cursor, cursor.HasValue ? true : null, PageSize: 5));
            all.AddRange(page.Items);
            if (!page.NextCursor.HasValue)
            {
                break;
            }
            cursor = page.NextCursor;
        }
        return all;
    }

    private async Task<List<SenderListItem>> LoadAllSendersAsync()
    {
        var all = new List<SenderListItem>();
        Guid? cursor = null;
        while (true)
        {
            var page = await SendersApiClient.GetSendersAsync(new GetSendersDto(cursor, cursor.HasValue ? true : null, PageSize: 5));
            all.AddRange(page.Items);
            if (!page.NextCursor.HasValue)
            {
                break;
            }
            cursor = page.NextCursor;
        }
        return all;
    }

    private void AddLineItem() => _lineItems.Add(new LineItemModel());

    private void RemoveLineItem(int index)
    {
        if (_lineItems.Count <= 1)
        {
            return;
        }

        _lineItems.RemoveAt(index);
    }

    private async Task Submit()
    {
        _serverErrors.Clear();
        _errorMessage = null;

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (!_model.CustomerId.HasValue || !_model.SenderId.HasValue)
        {
            _errorMessage = "Select a customer and a sender.";
            return;
        }

        var validLineItems = _lineItems
            .Where(li => !string.IsNullOrWhiteSpace(li.ItemName) && li.Quantity > 0)
            .ToList();

        if (validLineItems.Count == 0)
        {
            _errorMessage = "Add at least one line item with a name and a quantity greater than zero.";
            return;
        }

        try
        {
            _saving = true;

            var dto = new CreateInvoiceDto(
                InvoiceNumber: _model.InvoiceNumber,
                InvoiceDate: DateTime.SpecifyKind(_model.InvoiceDate!.Value.Date, DateTimeKind.Utc),
                DueDate: DateTime.SpecifyKind(_model.DueDate!.Value.Date, DateTimeKind.Utc),
                Currency: _model.Currency,
                Notes: _model.Notes,
                CustomerId: _model.CustomerId.Value,
                SenderId: _model.SenderId.Value,
                Subtotal: Subtotal,
                TaxRate: _taxRatePercent / 100m,
                TotalAmount: TotalAmount,
                LineItems: validLineItems
                    .Select(li => new InvoiceLineItemDto(li.ItemName, li.Quantity, li.UnitPrice, li.Total))
                    .ToList());

            await InvoicesApiClient.CreateInvoiceAsync(dto);

            Snackbar.Add($"Invoice {_model.InvoiceNumber} created", Severity.Success);
            ResetForm();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            HandleBadRequest(ex.Content);
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Save failed ({(int)ex.StatusCode} {ex.ReasonPhrase})", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetForm()
    {
        _model.InvoiceNumber = string.Empty;
        _model.InvoiceDate = DateTime.Today;
        _model.DueDate = DateTime.Today.AddDays(30);
        _model.Currency = "USD";
        _model.Notes = string.Empty;
        _model.CustomerId = null;
        _model.SenderId = null;
        _taxRatePercent = 0;
        _lineItems.Clear();
        _lineItems.Add(new LineItemModel());
        _serverErrors.Clear();
        _errorMessage = null;

        // Remount the form so every field's internal "touched"/validation state
        // (e.g. the Required asterisk turning red) starts clean, instead of
        // immediately re-showing errors for the freshly-cleared required fields.
        _formVersion++;
    }

    /// <summary>
    /// The create endpoint returns either a ValidationProblemDetails body (field-level
    /// errors from FluentValidation) or a bare ResultError body (business-rule failures
    /// such as a duplicate invoice number or an unknown customer/sender) - both as 400.
    /// </summary>
    private void HandleBadRequest(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            _errorMessage = "The request was invalid.";
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(content);

            if (doc.RootElement.TryGetProperty("errors", out var errors) && errors.ValueKind == JsonValueKind.Object)
            {
                foreach (var field in errors.EnumerateObject())
                {
                    var message = field.Value.ValueKind == JsonValueKind.Array
                        ? string.Join(" ", field.Value.EnumerateArray().Select(e => e.GetString()))
                        : field.Value.GetString();

                    if (!string.IsNullOrWhiteSpace(message))
                    {
                        _serverErrors[field.Name] = message!;
                    }
                }

                _errorMessage = "Please fix the highlighted fields.";
                return;
            }

            if (doc.RootElement.TryGetProperty("message", out var messageProp) && messageProp.ValueKind == JsonValueKind.String)
            {
                _errorMessage = messageProp.GetString();
                return;
            }
        }
        catch (JsonException)
        {
            // Fall through to the generic message below.
        }

        _errorMessage = "The request was invalid.";
    }

    private sealed class InvoiceFormModel
    {
        public string InvoiceNumber { get; set; } = string.Empty;
        public DateTime? InvoiceDate { get; set; } = DateTime.Today;
        public DateTime? DueDate { get; set; } = DateTime.Today.AddDays(30);
        public string Currency { get; set; } = "USD";
        public string Notes { get; set; } = string.Empty;
        public Guid? CustomerId { get; set; }
        public Guid? SenderId { get; set; }
    }

    private sealed class LineItemModel
    {
        public string ItemName { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal Total => Quantity * UnitPrice;
    }
}
