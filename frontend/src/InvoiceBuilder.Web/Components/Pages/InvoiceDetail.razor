@page "/invoices/{Id:guid}"
@rendermode InteractiveServer

@using System.Net
@using InvoiceBuilder.Application.Shared.Responses.Invoices
@using InvoiceBuilder.Web.Services
@using MudBlazor
@using Refit

@inject IInvoicesApiClient InvoicesApiClient
@inject NavigationManager NavigationManager

<PageTitle>Invoice @_invoice?.InvoiceNumber</PageTitle>

<MudContainer>
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" aria-label="Back to invoices" />
        <MudText Typo="Typo.h4">
            Invoice @_invoice?.InvoiceNumber
        </MudText>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_error
        </MudAlert>
    }

    @if (_invoice is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Invoice details</MudText>
                    <MudStack Spacing="1">
                        <MudText><b>Invoice date:</b> @_invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText>
                        <MudText><b>Due date:</b> @_invoice.DueDate.ToString("yyyy-MM-dd")</MudText>
                        <MudText><b>Currency:</b> @_invoice.Currency</MudText>
                        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
                        {
                            <MudText><b>Notes:</b> @_invoice.Notes</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Customer</MudText>
                    <MudStack Spacing="1">
                        <MudText>@_invoice.Customer.CompanyName</MudText>
                        <MudText>@_invoice.Customer.CustomerName</MudText>
                        <MudText>@_invoice.Customer.CustomerAddress</MudText>
                        <MudText>@_invoice.Customer.CustomerEmail</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Sender</MudText>
                    <MudStack Spacing="1">
                        <MudText>@_invoice.Sender.SenderCompanyName</MudText>
                        <MudText>@_invoice.Sender.SenderFullName</MudText>
                        <MudText>@_invoice.Sender.SenderAddress</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTable T="InvoiceLineItemResult" Items="_invoice.LineItems" Hover="true" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Item</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh Style="text-align:right">Unit price</MudTh>
                <MudTh Style="text-align:right">Total</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Item">@context.ItemName</MudTd>
                <MudTd DataLabel="Qty" Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                <MudTd DataLabel="Unit price" Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("N2")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No line items.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudPaper Class="pa-4" Elevation="1" MaxWidth="350px" Style="margin-left:auto">
            <MudStack Spacing="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText>Subtotal</MudText>
                    <MudText>@_invoice.Subtotal.ToString("N2") @_invoice.Currency</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText>Tax (@((_invoice.TaxRate * 100m).ToString("N2"))%)</MudText>
                    <MudText>@((_invoice.TotalAmount - _invoice.Subtotal).ToString("N2")) @_invoice.Currency</MudText>
                </MudStack>
                <MudDivider />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle1"><b>Total</b></MudText>
                    <MudText Typo="Typo.subtitle1"><b>@_invoice.TotalAmount.ToString("N2") @_invoice.Currency</b></MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    }

</MudContainer>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private GetInvoiceResult? _invoice;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
        => await LoadInvoice();

    private async Task LoadInvoice()
    {
        try
        {
            _loading = true;
            _error = null;
            _invoice = await InvoicesApiClient.GetInvoiceByIdAsync(Id);
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _error = "Invoice not found.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load invoice: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack()
        => NavigationManager.NavigateTo("/invoices");

}
