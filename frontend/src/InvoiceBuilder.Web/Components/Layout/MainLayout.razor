@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">@_pageTitle</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Notifications"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <MudMenuItem Disabled="true">No new notifications</MudMenuItem>
        </MudMenu>
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <MudMenuItem Disabled="true">Sign-in not yet available</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2">
        <MudDrawerHeader Class="d-flex align-center gap-3 px-4">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Invoice Builder</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="mud-text-secondary px-4">Overview</MudText>
            <MudNavLink Href="/"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>

            <MudText Typo="Typo.overline" Class="mud-text-secondary px-4 mt-4">Manage</MudText>
            <MudNavLink Href="/customers"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.People">
                Customers
            </MudNavLink>
            <MudNavLink Href="/senders"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Inventory">
                Senders
            </MudNavLink>
            <MudNavLink Href="/invoices"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.ReceiptLong">
                Invoices
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _pageTitle = "Dashboard";

    protected override void OnInitialized()
    {
        UpdatePageTitle(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');

        _pageTitle = path switch
        {
            "" => "Dashboard",
            "/customers" => "Customers",
            "/senders" => "Senders",
            "/invoices" => "Invoices",
            "/invoices/new" => "New Invoice",
            _ when path.StartsWith("/invoices/", StringComparison.Ordinal) => "Invoice Details",
            _ => "Invoice Builder",
        };
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (disposing)
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
        }
    }
}
